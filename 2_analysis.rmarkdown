## Configuration

```{r}
#| label: analysis-configuration

setFixest_notes(FALSE)  # Suppress fixest NOTE messages
filter_10 <- TRUE
# Causal forests is slow; set TRUE once to fit/save, then FALSE to reuse ests/
RUN_FORESTS <- FALSE
pref_var <- "party_preference_"

# Edit figure labels here
strategies <- 
  c("political\n(emotional)", "political\n(neutral)")

# Unified output directories (estimates / ggplot objects / PDFs)
est_dir <- "ests"
gg_dir  <- "ggs"
fig_dir <- "figs"

# Filename suffix by wave
wave_suffix <- c(
  wave_9 = "_shortterm",
  wave_10 = "_longterm"
)

wave_label_for <- function(wave) {
  if (wave == "wave_9") "Short-term Effects" else "Long-term Effects"
}

# Stem matches existing PDF names, e.g. f_I_shortterm, f_I_other_longterm
fig_stem <- function(prefix, outcome_group, wave) {
  paste0(prefix, str_replace(outcome_group, "main", ""), wave_suffix[[wave]])
}

# Outcomes and groups
v_outcomes <- c(
  "Like" = "videoLikep1r",
  "Share" = "videoSharep1r",
  "Bookmark" = "videoBookmarkp1r",
  "Report" = "videoCommentTickedp1r",
  "Watch Time" = "watch_percentage_",
  "Skip" = "skipped_video_"
)

l_outcomegroups <- list(
  main = c("Like", "Report", "Share", "Bookmark"),
  "_other" = c("Skip", "Watch Time")
)

l_partisanship <- list(
  "Supporter: Yes" = 1,
  "Supporter: No" = 0,
  "All" = c(0, 1)
)

party_codes <-  c("afd", "cdu", "linke", "spd", "gruene", "fdp", "bsw")
party_names <- c("AfD", "CDU/CSU", "Linke",   "SPD",  "Grüne",  "FDP",  "BSW")
names(party_codes) <- party_names
names(party_names) <- party_codes

# texreg: *** / ** / * map to these upper bounds (not 0.001/0.01/0.05)
texreg_stars <- c(0.01, 0.05, 0.10)

```


## Helper functions

```{r}
#| label: analysis-helper-functions
# Plot helpers

gg_coefplot <- function(data, aes) {
  ggplot(data, aes) +
    geom_vline(xintercept = 0, linetype = "dashed") +
    geom_point() +
    geom_errorbar(aes(xmin = conf.low, xmax = conf.high), width = 0.2) +
    theme_tiktok() +
    scale_color_tiktok()
}

# Theme and palette

theme_tiktok <- function() {
  theme_bw() +
    theme(
      legend.position = "none",
      axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1)
    )
}

scale_color_tiktok <- function() {
  scale_color_discrete()
}


# Party identification transition helpers
build_pid_lodes <- function(df_input) {
  labs <- party_names

  from <- df_input |>
    select(id_w9, starts_with("party_id_w9")) |>
    pivot_longer(-id_w9, names_to = "var", values_to = "val") |>
    filter(val == 1) |>
    transmute(
      id_w9,
      from_party = recode(
        sub("^party_id_w9_(.*)$", "\\1", var),
        !!!labs
      )
    )

  to <- df_input |>
    select(id_w9, starts_with("party_id_w10")) |>
    pivot_longer(-id_w9, names_to = "var", values_to = "val") |>
    filter(val == 1) |>
    transmute(
      id_w9,
      to_party = recode(
        sub("^party_id_w10_(.*)$", "\\1", var),
        !!!labs
      )
    )

  transitions_indiv <- inner_join(from, to, by = "id_w9")

  transitions <- transitions_indiv |>
    count(`Wave 9` = from_party, `Wave 10` = to_party, name = "Freq")

  totN <- sum(transitions$Freq)

  share_w9 <- transitions |>
    group_by(`Wave 9`) |>
    summarise(s9 = sum(Freq) / totN, .groups = "drop")

  share_w10 <- transitions |>
    group_by(`Wave 10`) |>
    summarise(s10 = sum(Freq) / totN, .groups = "drop")

  net_pp <- share_w10 |>
    left_join(share_w9, by = c("Wave 10" = "Wave 9")) |>
    mutate(
      delta_pp = (s10 - s9) * 100,
      label_right = sprintf("%s\n(%+0.2f pp)", `Wave 10`, delta_pp)
    ) |>
    select(`Wave 10`, label_right)

  lodes <- transitions |>
    mutate(Share = Freq / totN) |>
    to_lodes_form(axes = 1:2, id = "alluvium") |>
    mutate(
      x = factor(x, levels = c("Wave 9", "Wave 10")),
      stratum_lab = ifelse(
        x == "Wave 10",
        net_pp$label_right[match(stratum, net_pp$`Wave 10`)],
        as.character(stratum)
      )
    )

  party_cols <- c(
    "CDU/CSU" = "#000000",
    "SPD" = "#E3000F",
    "Grüne" = "#0DB02B",
    "FDP" = "#FFED00",
    "Linke" = "#E2382A",
    "AfD" = "#009EE0",
    "BSW" = "#18A19A"
  )

  list(lodes = lodes, party_cols = party_cols)
}

plot_pid_alluvial <- function(lodes, party_cols, title_text) {
  ggplot(
    lodes,
    aes(
      x = x,
      stratum = stratum,
      alluvium = alluvium,
      y = Share,
      fill = stratum,
      label = stratum_lab
    )
  ) +
    geom_alluvium(alpha = 0.7, color = NA, knot.pos = 0.4) +
    geom_stratum(fill = "white", color = "black", size = 0.3) +
    geom_text(stat = "stratum", size = 4) +
    scale_fill_manual(values = party_cols, guide = "none") +
    scale_x_discrete(
      labels = c("Wave 9", "Wave 10"),
      expand = c(0.05, 0.05)
    ) +
    labs(
      x = NULL,
      y = NULL,
      title = title_text
    ) +
    theme_minimal(base_size = 12) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold"),
      panel.grid = element_blank(),
      axis.text.y = element_blank()
    )
}

# Build correlation data for a single wave and treatment status
build_cor_df <- function(df, wave_label) {
  groups <- list(
    list(treat = "Treated", data = df |> filter(workshop_Treatment == 1)),
    list(treat = "Control", data = df |> filter(workshop_Treatment == 0))
  )
  purrr::map_df(groups, function(x) {
    df_sel <- x$data |> select(all_of(v_outcomes))
    colnames(df_sel) <- names(v_outcomes)
    cmat <- cor(df_sel, use = "pairwise.complete.obs")
    as.data.frame(as.table(cmat)) |>
      rename(var1 = Var1, var2 = Var2, r = Freq) |>
      mutate(treat = x$treat, wave = wave_label)
  })
}


# Main anlaysis function clusters by ID and fixed effects by video
# Run feols by group and return tidied coefficients with metadata
run_feols_tidy <- function(df, outcome_var, extra_cols = list()) {
  feols(
    as.formula(paste(outcome_var, "~ workshop_Treatment | video")),
    data = df,
    cluster = ~ID
  ) |>
    tidy(conf.int = TRUE) |>
    mutate(!!!extra_cols)
}

# Persist estimates, ggplot object, and PDF under matching stems
ensure_fig_dirs <- function() {
  dir.create(est_dir, showWarnings = FALSE)
  dir.create(gg_dir, showWarnings = FALSE)
  dir.create(fig_dir, showWarnings = FALSE)
}

write_fig <- function(stem, estimates, plot, width = NA, height = NA,
                      device = NULL) {
  ensure_fig_dirs()
  write_rds(estimates, file.path(est_dir, paste0(stem, ".rds")))
  write_rds(plot, file.path(gg_dir, paste0(stem, ".rds")))
  # cairo_pdf is preferred when available; plain pdf works on Windows without Cairo
  if (is.null(device)) {
    device <- if (isTRUE(capabilities("cairo"))) grDevices::cairo_pdf else grDevices::pdf
  }
  save_args <- list(
    filename = file.path(fig_dir, paste0(stem, ".pdf")),
    plot = plot,
    device = device
  )
  if (!is.na(width)) save_args$width <- width
  if (!is.na(height)) save_args$height <- height
  do.call(ggsave, save_args)
  print(plot)
  invisible(plot)
}
```



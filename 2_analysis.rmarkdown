# Main Results (Figure 1, 4, 5, and associated appendix figures)

Treatment effects by high-level video content types and displays/saves coefficient plots per outcome.

```{r}
#| label: analysis-main-results
for (D in c("wave_9", "wave_10")) {
  df <- datasets[[D]]

  for (OG in names(l_outcomegroups)) {
    estimates <- lapply(l_outcomegroups[[OG]], function(Y)
      lapply(unique(df$strategy_2), function(S) {
        df_sub <- df |> filter(strategy_2 == S)
        run_feols_tidy(
          df = df_sub,
          outcome_var = v_outcomes[Y],
          extra_cols = list(outcome = Y, strategy = S)
        )
      }) |>
        bind_rows()
    ) |>
      bind_rows() |>
      mutate(
        outcome = factor(outcome, levels = unique(outcome)),
        wave = D,
        wave_label = wave_label_for(D),
        outcome_group = OG,
        figure_id = "f_I"
      )

    plot <- estimates |>
      gg_coefplot(aes(y = strategy, x = estimate, color = strategy)) +
      facet_grid(cols = vars(outcome)) +
      labs(title = unique(estimates$wave_label))

    write_fig(
      stem = fig_stem("f_I", OG, D),
      estimates = estimates,
      plot = plot,
      width = 7,
      height = 3
    )
  }
}

```


# Conditional on sender (Figure 2 and related appendix figure)

Treatment effects within each party for political content types, per outcome.

```{r}
#| label: analysis-conditional-on-sender
for (D in c("wave_9", "wave_10")) {
  df <- datasets[[D]]

  for (OG in names(l_outcomegroups)) {
    estimates <- lapply(l_outcomegroups[[OG]], function(Y)
      lapply(strategies, function(S)
        lapply(names(party_codes), function(P) {
          df_sub <- df |> filter(strategy_2 == S, party == P)
          run_feols_tidy(
            df = df_sub,
            outcome_var = v_outcomes[Y],
            extra_cols = list(outcome = Y, strategy = S, party = P)
          )
        }) |>
          bind_rows()
      ) |>
        bind_rows()
    ) |>
      bind_rows() |>
      mutate(
        outcome = factor(outcome, levels = unique(outcome)),
        wave = D,
        wave_label = wave_label_for(D),
        outcome_group = OG,
        figure_id = "f_IIa"
      )

    plot <- estimates |>
      gg_coefplot(aes(y = strategy, x = estimate, color = strategy)) +
      facet_grid(cols = vars(outcome), rows = vars(party)) +
      labs(title = unique(estimates$wave_label))

    write_fig(
      stem = fig_stem("f_IIa", OG, D),
      estimates = estimates,
      plot = plot,
      width = 7,
      height = 6
    )
  }
}
```


# By partisanship (Figure 3 and related appendix figures)

This section estimates treatment effects by partisanship grouping (supporter yes/no/all) within political content types, per outcome.

```{r}
#| label: analysis-by-partisanship
for (D in c("wave_9", "wave_10")) {
  df <- datasets[[D]]

  for (OG in names(l_outcomegroups)) {
    estimates <- lapply(l_outcomegroups[[OG]], function(Y)
      lapply(strategies, function(S)
        lapply(names(l_partisanship), function(PS) {
          df_sub <- df |>
            filter(strategy_2 == S, partisan %in% l_partisanship[[PS]])
          run_feols_tidy(
            df = df_sub,
            outcome_var = v_outcomes[Y],
            extra_cols = list(outcome = Y, strategy = S, partisan = PS)
          )
        }) |>
          bind_rows()
      ) |>
        bind_rows()
    ) |>
      bind_rows() |>
      mutate(
        outcome = factor(outcome, levels = unique(outcome)),
        wave = D,
        wave_label = wave_label_for(D),
        outcome_group = OG,
        figure_id = "f_IIc"
      )

    plot <- estimates |>
      gg_coefplot(aes(y = strategy, x = estimate, color = strategy)) +
      facet_grid(cols = vars(outcome), rows = vars(partisan)) +
      labs(title = unique(estimates$wave_label))

    write_fig(
      stem = fig_stem("f_IIc", OG, D),
      estimates = estimates,
      plot = plot,
      width = 7,
      height = 6
    )
  }
}
```




# Article-figure dependencies

Estimation / `write_fig` for objects that `# Figures of article` reads from `ests/`. Placed here so a cold top-to-bottom render succeeds; appendix sections below redisplay the saved plots.

## f_IIc3: by partisanship and party

This section estimates treatment effects by party and partisanship, with nested facet labels. Needed by Figure 1 (`f_IIc3_shortterm`).

```{r}
#| label: analysis-f_IIc3-partisanship-party
for (D in c("wave_9", "wave_10")) {
  df <- datasets[[D]]

  for (OG in names(l_outcomegroups)) {
    estimates <- lapply(l_outcomegroups[[OG]], function(Y)
      lapply(strategies, function(S)
        lapply(names(l_partisanship), function(PS)
          lapply(names(party_codes), function(P) {
            df_temp <- df |> filter(strategy_2 == S, partisan %in% l_partisanship[[PS]], party == P)
            y <- df_temp[[v_outcomes[Y]]]
            if (nrow(df_temp) == 0 || all(is.na(y)) || length(unique(na.omit(y))) < 2) {
              print(paste("skipping ", paste(P, PS, S, Y, sep = "/"), " 
                          (NO ESTIMATION POSSIBLE: constant/NA DV)"))
              return(NULL)
            }
            run_feols_tidy(
              df = df_temp,
              outcome_var = v_outcomes[Y],
              extra_cols = list(
                outcome = Y,
                strategy = S,
                partisan = as.character(PS),
                party = P
              )
            )
          })
        ) |> bind_rows()) |> bind_rows()) |> bind_rows() |>
      mutate(
        outcome = factor(outcome, levels = unique(outcome)),
        wave = D,
        wave_label = wave_label_for(D),
        outcome_group = OG,
        figure_id = "f_IIc3"
      )

    plot <- estimates |>
      gg_coefplot(aes(y = strategy, x = estimate, color = strategy)) +
      facet_nested(
        rows = vars(party, partisan),
        cols = vars(outcome),
        strip = strip_nested(
          text_y = list(
            element_text(angle = 90),
            element_text(angle = 0, hjust = 0)
          ),
          by_layer_y = TRUE
        )
      ) +
      labs(title = unique(estimates$wave_label)) +
      theme(
        panel.spacing.y = unit(0, "pt"),
        strip.background.y = element_rect(fill = "grey90", color = "black"),
        legend.position = "none",
        axis.text = element_text(size = 6.5)
      )

    write_fig(
      stem = fig_stem("f_IIc3", OG, D),
      estimates = estimates,
      plot = plot,
      width = 7,
      height = 11
    )
  }
}
```

## PTV effects by prior identification

Short- and long-term workshop effects on PTV by party, split by wave-9 identifiers. Saved stems feed `## Figure PTV (combined)`.

```{r}
#| label: analysis-shortterm-ptv-plot-by-id
#| fig-height: 7
#| fig-width: 7

# Short-term PTV effects by party, split by wave 9 identifiers

ptv_short_by_id_raw <-
  party_codes |>
  lapply(function(party) {
    pre_var <- paste0("ptv_w9_pre_", party)
    post_var <- paste0("ptv_w9_post_", party)
    id_var  <- paste0("party_id_w9_", party)

    fml <- paste0(post_var, " ~ workshop * ", pre_var) |>
      as.formula()

    # All respondents (conditional on continuous baseline PTV)
    m_all <- lm_robust(fml, data = df_w9_w10)

    # Among identifiers (party ID at wave 9 == 1)
    m_id <- lm_robust(
      fml,
      data = df_w9_w10 |> dplyr::filter(!!rlang::sym(id_var) == 1)
    )

    # Among non-identifiers (party ID at wave 9 == 0)
    m_non <- lm_robust(
      fml,
      data = df_w9_w10 |> dplyr::filter(!!rlang::sym(id_var) == 0)
    )

    dplyr::bind_rows(
      tidy(m_all) |> dplyr::filter(term == "workshop") |>
        dplyr::mutate(group = "All respondents"),
      tidy(m_id)  |> dplyr::filter(term == "workshop") |>
        dplyr::mutate(group = "Identifiers"),
      tidy(m_non) |> dplyr::filter(term == "workshop") |>
        dplyr::mutate(group = "Non-identifiers")
    ) |>
      dplyr::mutate(party = party_names[[party]])
  }) |>
  dplyr::bind_rows()

party_order_short <-
  ptv_short_by_id_raw |>
  dplyr::filter(group == "All respondents") |>
  dplyr::arrange(estimate) |>
  dplyr::pull(party)

ptv_short_by_id <-
  ptv_short_by_id_raw |>
  dplyr::mutate(
    party = factor(party, levels = party_order_short),
    group = factor(
      group,
      levels = c("All respondents", "Identifiers", "Non-identifiers")
    )
  )

fig_shortterm_ptv_by_id <-
  ptv_short_by_id |>
  ggplot(aes(x = estimate, y = party, color = group)) +
  geom_vline(xintercept = 0, linetype = "dashed", alpha = 0.5) +
  geom_point(position = position_dodge(width = 0.6), size = 2.5) +
  geom_errorbarh(
    aes(xmin = conf.low, xmax = conf.high),
    position = position_dodge(width = 0.6),
    height = 0.2
  ) +
  geom_text(
    aes(
      label = sprintf("%.3f (p = %.3f)", estimate, p.value),
      group = group
    ),
    position = position_dodge(width = 0.6),
    hjust = 0.5,
    vjust = -0.7,
    size = 2.5,
    show.legend = FALSE
  ) +
  labs(
    x = "Effect of workshop on short-term PTV (wave 9, 0–1 scale)",
    y = "Party",
    color = NULL,
    title = "Short-term PTV effects of digital literacy workshop",
    subtitle = "Average effect, identifiers, and non-identifiers"
  ) +
  theme_bw()

write_fig(
  stem = "fig_shortterm_ptv_by_id",
  estimates = ptv_short_by_id,
  plot = fig_shortterm_ptv_by_id,
  width = 7,
  height = 9
)
```

```{r}
#| label: analysis-longterm-ptv-plot-by-id
#| fig-height: 7
#| fig-width: 7

# Long-term PTV effects by party, split by wave 9 identifiers

ptv_long_by_id_raw <-
  party_codes |>
  lapply(function(party) {
    pre_var <- paste0("ptv_w9_pre_", party)
    post_var <- paste0("ptv_w10_", party)
    id_var  <- paste0("party_id_w9_", party)

    fml <- paste0(post_var, " ~ workshop * ", pre_var) |>
      as.formula()

    # All respondents (conditional on continuous baseline PTV)
    m_all <- lm_robust(fml, data = df_w9_w10)

    # Among identifiers (party ID at wave 9 == 1)
    m_id <- lm_robust(
      fml,
      data = df_w9_w10 |> dplyr::filter(!!rlang::sym(id_var) == 1)
    )

    # Among non-identifiers (party ID at wave 9 == 0)
    m_non <- lm_robust(
      fml,
      data = df_w9_w10 |> dplyr::filter(!!rlang::sym(id_var) == 0)
    )

    dplyr::bind_rows(
      tidy(m_all) |> dplyr::filter(term == "workshop") |>
        dplyr::mutate(group = "All respondents"),
      tidy(m_id)  |> dplyr::filter(term == "workshop") |>
        dplyr::mutate(group = "Identifiers"),
      tidy(m_non) |> dplyr::filter(term == "workshop") |>
        dplyr::mutate(group = "Non-identifiers")
    ) |>
      dplyr::mutate(party = party_names[[party]])
  }) |>
  dplyr::bind_rows()

party_order_long <-
  ptv_long_by_id_raw |>
  dplyr::filter(group == "All respondents") |>
  dplyr::arrange(estimate) |>
  dplyr::pull(party)

ptv_long_by_id <-
  ptv_long_by_id_raw |>
  dplyr::mutate(
    party = factor(party, levels = party_order_long),
    group = factor(
      group,
      levels = c("All respondents", "Identifiers", "Non-identifiers")
    )
  )

fig_longterm_ptv_by_id <-
  ptv_long_by_id |>
  ggplot(aes(x = estimate, y = party, color = group)) +
  geom_vline(xintercept = 0, linetype = "dashed", alpha = 0.5) +
  geom_point(position = position_dodge(width = 0.6), size = 2.5) +
  geom_errorbarh(
    aes(xmin = conf.low, xmax = conf.high),
    position = position_dodge(width = 0.6),
    height = 0.2
  ) +
  geom_text(
    aes(
      label = sprintf("%.3f (p = %.3f)", estimate, p.value),
      group = group
    ),
    position = position_dodge(width = 0.6),
    hjust = 0.5,
    vjust = -0.7,
    size = 2.5,
    show.legend = FALSE
  ) +
  labs(
    x = "Effect of workshop on long-term PTV (wave 10, 0–1 scale)",
    y = "Party",
    color = NULL,
    title = "Long-term PTV effects of digital literacy workshop",
    subtitle = "Average effect, identifiers, and non-identifiers"
  ) +
  theme_bw()

write_fig(
  stem = "fig_longterm_ptv_by_id",
  estimates = ptv_long_by_id,
  plot = fig_longterm_ptv_by_id,
  width = 7,
  height = 9
)
```


# Figures of article


## Figure 1

Combines pooled content-type effects (`f_I_shortterm`) as an All-parties row (including entertainment) with party × supporter effects (`f_IIc3_shortterm`). Supporters are shown only in party rows (color + dodge).

```{r}
#| label: figure1-assembly
#| fig-width: 7
#| fig-height: 8

est_all <- read_rds(file.path(est_dir, "f_I_shortterm.rds")) |>
  mutate(
    party = "All parties",
    partisan = NA_character_
  )

# Legend / dodge order: All, Yes, No. Factor levels bottom→top on y-dodge,
# so reverse coding puts All visually on top; legend is reversed to match.
partisan_order <- c("All", "Supporter: Yes", "Supporter: No")
partisan_dodge_levels <- rev(partisan_order)

est_party <- read_rds(file.path(est_dir, "f_IIc3_shortterm.rds")) |>
  mutate(
    partisan = factor(partisan, levels = partisan_dodge_levels)
  )

party_levels <- c("All parties", names(party_codes))
# Desired top→bottom on y: emotional, neutral, entertainment
strategy_order <- c(
  "political\n(emotional)",
  "political\n(neutral)",
  "entertainment"
)
outcome_levels <- levels(est_all$outcome)
if (is.null(outcome_levels)) {
  outcome_levels <- unique(as.character(est_all$outcome))
}

est_all <- est_all |>
  mutate(
    party = factor(party, levels = party_levels),
    strategy = factor(strategy, levels = rev(strategy_order)),
    outcome = factor(outcome, levels = outcome_levels)
  )

est_party <- est_party |>
  mutate(
    party = factor(party, levels = party_levels),
    strategy = factor(strategy, levels = rev(strategy_order)),
    outcome = factor(outcome, levels = outcome_levels)
  )

estimates_fig1 <- bind_rows(
  est_all |> mutate(source = "f_I"),
  est_party |> mutate(source = "f_IIc3")
)

# Symmetric clip at largest |point estimate| (CIs may be truncated)
x_half <- max(abs(estimates_fig1$estimate), na.rm = TRUE)
dodge <- position_dodge(width = 0.55)

fig1 <- ggplot() +
  geom_vline(xintercept = 0, linetype = "dashed") +
  # All-parties pooled row: no supporter split; includes entertainment
  geom_errorbar(
    data = est_all,
    aes(xmin = conf.low, xmax = conf.high, y = strategy),
    width = 0.2
  ) +
  geom_point(
    data = est_all,
    aes(x = estimate, y = strategy),
    size = 1.5
  ) +
  # Party rows: supporter All / Yes / No
  geom_errorbar(
    data = est_party,
    aes(xmin = conf.low, xmax = conf.high, y = strategy, color = partisan),
    width = 0.2,
    position = dodge
  ) +
  geom_point(
    data = est_party,
    aes(x = estimate, y = strategy, color = partisan),
    size = 1.5,
    position = dodge
  ) +
  facet_grid(
    rows = vars(party),
    cols = vars(outcome),
    scales = "free_y",
    space = "free_y"
  ) +
  scale_y_discrete(drop = TRUE) +
  scale_color_discrete(limits = partisan_order, breaks = partisan_order) +
  coord_cartesian(xlim = c(-x_half, x_half)*0.92) +
  labs(
    x = "Average treatment effect",
    y = NULL,
    color = NULL,
    title = "Short-term Effects"
  ) +
  theme_bw(base_size = 10) +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(angle = 0, vjust = 0.5, hjust = 0.5, size = 9),
    axis.text.y = element_text(size = 9),
    axis.title = element_text(size = 10),
    strip.text.x = element_text(size = 10),
    strip.text.y = element_text(angle = -90, size = 10),
    legend.text = element_text(size = 9),
    plot.title = element_text(size = 12),
    panel.spacing.y = unit(3, "pt")
  )

write_fig(
  stem = "Figure1_combined",
  estimates = estimates_fig1,
  plot = fig1,
  width = 12,
  height = 9
)
```

## Figure PTV (combined)

Single-panel faceted figure for the paper: short-term (wave 9) and long-term (wave 10) workshop effects on PTV by party and prior identification. Estimates reuse saved `fig_*term_ptv_by_id` objects (same models as the appendix PTV-by-id chunks).

```{r}

```

# Comparing video types

Formal tests of whether short-term treatment effects on liking and reporting differ across video types. For each outcome and group we estimate

$$
Y = \beta_0 + \beta_1 \text{Treatment} + \beta_2 \text{Type} + \beta_3 (\text{Treatment} \times \text{Type}) + \varepsilon
$$

on the two types being compared only (no video fixed effects, so all three slopes are identified). `Type` = 1 for emotionally manipulative political content and 0 for the comparison type. Standard errors are clustered by respondent. $\beta_1$ is the ATE for the comparison type; $\beta_3$ is the difference in ATEs (emotional minus comparison).

Groups: **ALL** (pooled) and each sending party. Short-term sample (`wave_9`) only. Outcomes: Like and Report. One regression table per outcome; columns are groups.

```{r}
#| label: comparing-video-types-setup

ensure_fig_dirs()
dir.create("tabs", showWarnings = FALSE)

compare_outcomes <- c("Like", "Report")
compare_group_names <- c("ALL", names(party_codes))

fit_type_contrast <- function(df, outcome_name, type_var) {
  y <- v_outcomes[[outcome_name]]
  fml <- as.formula(paste0(y, " ~ workshop_Treatment * ", type_var))
  feols(fml, data = df, cluster = ~ID)
}

type_contrast_coef_map <- list(
  "(Intercept)" = "Intercept",
  "workshop_Treatment" = "Treatment (comparison type)",
  "emotional" = "Emotional (vs comparison)",
  "workshop_Treatment:emotional" = "Treatment × type"
)

write_type_contrast_table <- function(models, outcome_name, contrast_slug,
                                      caption, label) {
  stem <- paste0("tab_compare_", contrast_slug, "_", tolower(outcome_name))
  write_rds(models, file.path(est_dir, paste0(stem, ".rds")))
  texreg::texreg(
    models,
    file = file.path("tabs", paste0(stem, ".tex")),
    digits = 3,
    include.ci = FALSE,
    custom.model.names = names(models),
    custom.coef.map = type_contrast_coef_map,
    caption = caption,
    label = label,
    stars = texreg_stars
  )
  texreg::htmlreg(
    models,
    digits = 3,
    include.ci = FALSE,
    custom.model.names = names(models),
    custom.coef.map = type_contrast_coef_map,
    caption = caption,
    stars = texreg_stars
  )
}
```

## Emotional vs politically neutral

Restricted to political videos coded emotional or neutral. For party columns, only videos from that party.

```{r}
#| label: comparing-video-types-emotional-vs-neutral
#| results: 'asis'

# Indicator: 1 = emotional political, 0 = neutral political
df_pol <- datasets$wave_9 |>
  filter(strategy_2 %in% strategies) |>
  mutate(emotional = as.integer(strategy_2 == strategies[1]))

models_emo_neu <- lapply(compare_outcomes, function(Y) {
  fits <- c(
    list(ALL = fit_type_contrast(df_pol, Y, "emotional")),
    lapply(names(party_codes), function(P) {
      fit_type_contrast(df_pol |> filter(party == P), Y, "emotional")
    }) |> setNames(names(party_codes))
  )
  fits[compare_group_names]
}) |>
  setNames(compare_outcomes)

write_rds(models_emo_neu, file.path(est_dir, "tab_compare_emotional_vs_neutral.rds"))

cat("\n### Like\n\n")
write_type_contrast_table(
  models_emo_neu$Like,
  "Like",
  "emotional_vs_neutral",
  caption = "Emotional vs politically neutral: Like (short-term). SEs clustered by respondent.",
  label = "tab:compare_emotional_vs_neutral_like"
)

cat("\n### Report\n\n")
write_type_contrast_table(
  models_emo_neu$Report,
  "Report",
  "emotional_vs_neutral",
  caption = "Emotional vs politically neutral: Report (short-term). SEs clustered by respondent.",
  label = "tab:compare_emotional_vs_neutral_report"
)
```

